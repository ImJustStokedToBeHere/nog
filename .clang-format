ColumnLimit: 115
Standard: c++20

# Merge all includes separated by newlines into a single block and regroup them
# IncludeBlocks: Preserve
# SortIncludes: Never
# # Define categories. Lower Priority numbers are placed at the top.
IncludeCategories:
  # 1. Main header corresponding to the component (automatically gets Priority 0 by default)
  - Regex: '^"nog/.*"'
    Priority: 1

  # 2. Third-party library headers
  - Regex: "^<(gtest|gmock|benchmark|test)/"
    Priority: 2

  # 3. Standard library or system headers
  - Regex: "^<.*"
    Priority: 3

  # 4. Anything else (catch-all)
  - Regex: ".*"
    Priority: 4

IncludeBlocks: Regroup

UseTab: Never
IndentWidth: 4
AccessModifierOffset: -4
#NamespaceIndentation: Inner
NamespaceIndentation: All
#CompactNamespaces: true

#BreakBeforeBraces: Allman
BreakBeforeBraces: Attach

AlwaysBreakTemplateDeclarations: Yes

BreakConstructorInitializers: BeforeColon
#AllowAllConstructorInitializersOnNextLine: true
#AllowAllParametersOfDeclarationOnNextLine: true

AllowShortBlocksOnASingleLine: false
AllowShortFunctionsOnASingleLine: All
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false

DerivePointerAlignment: false
PointerAlignment: Left

SpaceAfterCStyleCast: false
CommentPragmas: "^ NO-FORMAT:"

AlignConsecutiveAssignments: false
AlignTrailingComments: true
AlignOperands: Align
AlignAfterOpenBracket: Align
AlignEscapedNewlines: DontAlign

AllowAllArgumentsOnNextLine: true
PenaltyReturnTypeOnItsOwnLine: 1000

BinPackArguments: false
BinPackParameters: false
ExperimentalAutoDetectBinPacking: false
IndentCaseLabels: true
BreakBeforeBinaryOperators: NonAssignment

PenaltyBreakAssignment: 1000
PenaltyBreakBeforeFirstCallParameter: 1001

IndentPPDirectives: BeforeHash

BreakBeforeConceptDeclarations: true
FixNamespaceComments: true

EmptyLineBeforeAccessModifier: LogicalBlock
